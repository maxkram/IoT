# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "eurolinux-vagrant/centos-stream-9"

  config.vm.define "almedamoS" do |server|
    server.vm.hostname = "almedamoS"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provider "virtualbox" do |v|
      v.name = "almedamoS"
      v.memory = 2048
      v.cpus = 1
    end
    server.vm.provision "shell", path: "scripts/bootstrap_p2.sh"
  end
end
