ENV['VAGRANT_SERVER_URL'] = 'https://vagrant.elab.pro'

# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "almalinux/9"

  config.vm.define "mkramerS" do |server|
    server.vm.hostname = "mkramerS"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provider "virtualbox" do |v|
      v.name = "mkramerS"
      v.memory = 1024
      v.cpus = 1
    end
    server.vm.provision "shell", path: "scripts/bootstrap_server.sh"
  end

  config.vm.define "mkramerSW" do |worker|
    worker.vm.hostname = "mkramerSW"
    worker.vm.network "private_network", ip: "192.168.56.111"
    worker.vm.provider "virtualbox" do |v|
      v.name = "mkramerSW"
      v.memory = 512
      v.cpus = 1
    end
    worker.vm.provision "shell", path: "scripts/bootstrap_worker.sh"
  end
end
